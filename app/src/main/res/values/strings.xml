    <!-- Permissions -->
    <string name="permission_accessibility_label_title">Accessibility service</string>
    <string name="permission_accessibility_label_desc">Primary engine. Reads on-screen text directly from the active window, fast &amp; accurate and battery-friendly.</string>
    <string name="permission_overlay_label_title">Display over other apps</string>
    <string name="permission_overlay_label_desc">Lets TextGrab draw the selectable text layer on top of whatever you are viewing.</string>
    <string name="permission_notifications_label_title">Notifications</string>
    <string name="permission_notifications_label_desc">Required to show status indicators while TextGrab is reading your screen or downloading OCR language packages.</string>
    <string name="permission_notifications_action_button_grant">Grant</string>
    <string name="permission_projection_label_title">Screen capture (OCR fallback)</string>
    <string name="permission_projection_label_desc">Used only when a screen can\'t be read directly (Eg: images, canvas, games or protected views) Consent is requested each time.</string>

    <!-- Quick Settings Tile -->
    <string name="tile_label_name">TextGrab</string>
    <string name="tile_setup_label_title">Add the Quick Settings tile</string>
    <string name="tile_setup_label_desc">Swipe down twice, tap the edit (pencil) button, then drag the TextGrab tile into your active tiles. Tap it any time to grab text instantly.</string>
