    <string name="accessibility_service_label_name">TextGrab: Text Extraction</string>
    <string name="accessibility_service_label_description">TextGrab reads the text on your current screen so you can tap to copy any word, line or block, including Arabic and Latin scripts. Text is processed on-device and is never uploaded.</string>

