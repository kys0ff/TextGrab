    <string name="permission_accessibility_label_desc">Haupt-Engine. Liest Text direkt aus dem aktiven Fenster, schnell, genau und akkuschonend.</string>
    <string name="permission_accessibility_label_title">Bedienungshilfen-Dienst</string>
