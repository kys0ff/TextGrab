    <!-- Accessibility -->
    <string name="accessibility_service_label_description">TextGrab liest den Text auf Ihrem aktuellen Bildschirm, sodass Sie auf jedes Wort, jede Zeile oder jeden Block tippen können, um sie zu kopieren, einschließlich arabischer und lateinischer Schriften. Der Text wird auf dem Gerät verarbeitet und niemals hochgeladen.</string>
    <string name="accessibility_service_label_name">TextGrab: Textextraktion</string>

