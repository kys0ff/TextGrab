    <!-- Permissions -->
    <string name="permission_accessibility_label_title">خدمة إمكانية الوصول</string>
    <string name="permission_accessibility_label_desc">المحرك الأساسي. يقرأ النص مباشرةً من النافذة النشطة — سريع ودقيق وموفّر للبطارية.</string>
    <string name="permission_overlay_label_title">العرض فوق التطبيقات الأخرى</string>
    <string name="permission_overlay_label_desc">يسمح لتكست غراب برسم طبقة النص القابلة للتحديد فوق ما تشاهده.</string>
    <string name="permission_notifications_label_title">الإشعارات</string>
    <string name="permission_notifications_label_desc">مطلوب لإظهار مؤشر الحالة بينما يقوم تكست غراب بقراءة شاشتك للتعرف الضوئي على النص.</string>
    <string name="permission_notifications_action_button_grant">منح الإذن</string>
    <string name="permission_projection_label_title">التقاط الشاشة (احتياطي OCR)</string>
    <string name="permission_projection_label_desc">يُستخدم فقط عندما يتعذّر قراءة الشاشة مباشرةً — الصور واللوحات والألعاب والعروض المحمية. تُطلب الموافقة في كل مرة.</string>

    <!-- Quick Settings Tile -->
    <string name="tile_label_name">تكست غراب</string>
    <string name="tile_setup_label_title">أضف مربّع الإعدادات السريعة</string>
    <string name="tile_setup_label_desc">اسحب لأسفل مرتين، اضغط على زر التعديل (القلم)، ثم اسحب مربّع تكست غراب إلى المربعات النشطة. اضغط عليه في أي وقت لالتقاط النص فورًا.</string>
