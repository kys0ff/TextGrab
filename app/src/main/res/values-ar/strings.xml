    <!-- OCR Packages -->
    <string name="ocr_package_label_title">حزم OCR</string>
    <string name="ocr_package_label_desc">قم بتنزيل بيانات اللغة للتعرف الضوئي على النصوص بدون إنترنت. النماذج عالية الدقة (الأفضل) أبطأ وأكبر، بينما النماذج المحسنة (السريعة) تستهلك ذاكرة أقل.</string>
    <string name="ocr_package_label_version_fast">سريع</string>
