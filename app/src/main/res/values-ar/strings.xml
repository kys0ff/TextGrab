    <!-- Accessibility Service -->
    <string name="accessibility_service_label_name">استخراج النص من تكست غراب</string>
    <string name="accessibility_service_label_description">يقرأ تكست غراب النص الموجود على شاشتك الحالية حتى تتمكن من النقر لنسخ أي كلمة أو سطر أو فقرة — بما في ذلك النصوص العربية واللاتينية. تتم المعالجة على الجهاز ولا يتم رفع أي بيانات.</string>

